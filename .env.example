# --- Pflicht ---

# Discord Webhook-URL für den News/Tor-Channel.
# Holen: Channel -> Bearbeiten -> Integrationen -> Webhooks -> Neuer Webhook.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY


# --- Optional, aber empfohlen ---

# football-data.org API Token (gratis, 10 req/min).
# Registrieren: https://www.football-data.org/client/register
# Ohne diesen Token: News funktionieren, aber KEINE Tor-Pings.
FOOTBALL_DATA_TOKEN=

# Wer wird bei Tor / Anpfiff / Abpfiff gepingt.
# @everyone  ... pingt den ganzen Server
# <@&ROLL_ID> ... pingt eine Rolle (z.B. "Nati-Fans"). Rollen-ID via Discord Developer Mode -> Rechtsklick auf Rolle.
GOAL_PING_MENTION=@everyone


# --- Nur für Vercel-Deployment ---

# Random String. Vercel schickt ihn als Authorization-Header an dein /api/cron/poll
# damit Fremde deinen Endpoint nicht missbrauchen können. Beliebige zufällige Zeichenkette.
CRON_SECRET=

# Vercel KV — werden automatisch gesetzt sobald du im Vercel Dashboard
# "Storage -> Create -> KV -> Connect Project" gemacht hast. Lokal kannst du sie leer lassen.
KV_REST_API_URL=
KV_REST_API_TOKEN=


# --- Nur lokal ---

# Polling-Intervall in Minuten wenn du `npm run dev` läufst.
INTERVAL_MINUTES=5
